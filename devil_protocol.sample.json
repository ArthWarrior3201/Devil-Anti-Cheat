{
  "endpoint": "https://ac.acmegames.com/v1/hwcheck",
  "method": "POST",
  "auth": { "type": "bearer", "token": "REPLACE_WITH_COMPANY_API_TOKEN" },
  "scope": "acme-studio",
  "request": { "hwid_field": "hardware_hash", "nonce_field": "nonce", "scope_field": "scope", "static": { "title": "acme-fps", "ac": "devil" } },
  "response": { "banned_path": "result.banned", "reason_path": "result.reason", "sig_path": "result.sig" },
  "timeout_s": 4.0,
  "retries": 2,
  "verify_tls": true,
  "fail_mode": "open",
  "require_signed_response": true,
  "server_public_key": "REPLACE_WITH_SERVER_ED25519_PUBLIC_KEY_HEX"
}
