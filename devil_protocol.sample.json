{
  "endpoint": "https://ac.acmegames.com/v1/hwcheck",
  "method": "POST",
  "auth": { "type": "bearer", "token": "REPLACE_WITH_COMPANY_API_TOKEN" },
  "request": { "hwid_field": "hardware_hash", "static": { "title": "acme-fps", "ac": "devil" } },
  "response": { "banned_path": "result.banned", "reason_path": "result.reason" },
  "timeout_s": 4.0,
  "retries": 2,
  "verify_tls": true,
  "fail_mode": "open"
}
